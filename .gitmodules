[submodule "third_party/spdlog"]
	path = third_party/spdlog
	url = https://github.com/gabime/spdlog.git
[submodule "third_party/entt"]
	path = third_party/entt
	url = https://github.com/skypjack/entt.git
[submodule "third_party/yaml-cpp"]
	path = third_party/yaml-cpp
	url = https://github.com/jbeder/yaml-cpp.git
[submodule "third_party/enkiTS"]
	path = third_party/enkiTS
	url = https://github.com/dougbinks/enkiTS.git
[submodule "third_party/nvrhi"]
	path = third_party/nvrhi
	url = https://github.com/NVIDIA-RTX/NVRHI.git
[submodule "third_party/SDL3"]
	path = third_party/SDL3
	url = https://github.com/libsdl-org/SDL.git
	shallow = true
[submodule "third_party/glm"]
	path = third_party/glm
	url = https://github.com/g-truc/glm.git
	shallow = true
